# Copy this file to .env and fill in real values before running the server.
# Never commit your real .env file to git.

# Port the server listens on
PORT=3000

# A long, random, secret string used to sign login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret

# Optional: your Anthropic API key, only needed if you want the "Watt" chat
# assistant to give live AI-generated answers. Without this, Watt still works
# great — it runs on a built-in, scripted knowledge base (company info,
# products, plans, WZN, contact details) that costs nothing and needs no key.
# Get a key at https://console.anthropic.com/ (Account Settings -> API Keys)
# if you ever want to upgrade Watt to live AI answers later.
ANTHROPIC_API_KEY=

# Set to "production" when deployed on your real domain over HTTPS.
NODE_ENV=development

# Admin panel login — visit /admin on your site to manage users and WZN tokens.
# Change this password before you go live on your real domain.
ADMIN_USERNAME=waenergyadmin
ADMIN_PASSWORD=energywithoutlimit
